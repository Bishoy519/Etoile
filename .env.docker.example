# ==============================================================================
# 🩰 ÉTOILE BALLET ACADEMY — DOCKER ENVIRONMENT VARIABLES
# Copy to .env or pass directly to docker compose
# ==============================================================================

# PostgreSQL 16 Database Configuration
POSTGRES_DB=etoile
POSTGRES_USER=root
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5432

# NestJS REST Engine Configuration
PORT=3001
# REQUIRED in production: >= 32 random chars. The API refuses to boot in
# production without it (see server/src/common/security.util.ts).
# Generate: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars
AUTO_SEED=true

# --- Hardening / site options (all optional) ---
# Session lifetimes in seconds (30-min access + 30-day rotating refresh).
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=2592000
# Scrub one-time secrets (temp passwords, OTPs) from stored WhatsApp logs.
# Recommended: true in production with a real sender.
OPENWA_REDACT_SECRETS=false
# On-premise WiFi fingerprint used to verify kiosk check-ins server-side.
PREMISE_WIFI_BSSID=Etoile-Secure-5G [F4:92:BF:11:80:A2]

# Frontend Port Mappings (Host Ports)
CLIENT_PORT=5173
ADMIN_PORT=5174

# --- Payments: Paymob / Fawry / InstaPay (all optional, mock mode when empty) ---
# PUBLIC_APP_URL is used to build pay-link URLs sent on WhatsApp.
PUBLIC_APP_URL=http://localhost:5174
# Optional override for the pay-link base (defaults to PUBLIC_APP_URL + /pay).
PAYLINK_PORTAL_URL=
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
FAWRY_MERCHANT=
FAWRY_SECURITY_KEY=
# --- Egypt Tax Authority e-invoicing (stubbed until keys set) ---
ETA_API_KEY=
ETA_TAX_ID=
ETA_ISSUER_NAME=Étoile Ballet Academy
# --- Web-Push (native lock-screen receipts; stubbed until keys set) ---
# Generate: npm --prefix server run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@etoile.academy
# --- Guardian SMS fallback (auto-sends when WhatsApp dispatch fails) ---
# SMS_PROVIDER: none | twilio | webhook
SMS_PROVIDER=none
# Twilio driver:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Generic webhook driver: POST {to, message} as JSON.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_KEY=
# --- Observability ---
SENTRY_DSN=
WA_PROVIDER=builtin_qr
