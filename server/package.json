{
  "name": "etoile-api",
  "version": "1.0.0",
  "description": "Étoile Ballet Academy Management REST API (NestJS)",
  "private": true,
  "scripts": {
    "build": "tsc && tsc prisma/seed.ts --outDir dist/prisma --skipLibCheck --target ES2021 --module commonjs",
    "build:seed": "tsc prisma/seed.ts --outDir dist/prisma --skipLibCheck --target ES2021 --module commonjs",
    "seed": "node dist/prisma/seed.js",
    "cron:nightly": "ts-node src/cron/nightly.ts",
    "push:keys": "node -e \"const w=require('web-push'); console.log(JSON.stringify(w.generateVAPIDKeys(), null, 2))\"",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test": "node src/attendance-receipt-ifrs15-audit.test.mjs && node src/api-security-audit.test.mjs && node src/courses-whatsapp-audit.test.mjs && node src/card-auth-schedule-audit.test.mjs && node src/end-to-end-lifecycle.test.mjs && node src/security-hardening-audit.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.3",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.3.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "@types/qrcode": "^1.5.6",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
