datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model StaffUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  nameAr       String?
  role         String   @default("receptionist") // 'superadmin', 'owner', 'receptionist', 'instructor'
  department   String   @default("Operations")
  departmentAr String?  @default("العمليات")
  avatarUrl    String?
  passwordHash String
  cardCode     String?         @unique
  phone        String?
  isFirstLogin Boolean         @default(false)
  otpCode      String?
  otpExpiresAt DateTime?
  otpAttempts      Int       @default(0)
  otpLockedUntil   DateTime?
  failedLoginAttempts Int      @default(0)
  loginLockedUntil    DateTime?
  shiftActive        Boolean         @default(false)
  instructedCourses  Course[]
  instructedSessions CourseSession[]
  ledGroups          Group[]          @relation("GroupLead")
  shifts             StaffShift[]
  leaves             StaffLeave[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model StaffShift {
  id        String    @id @default(cuid())
  staffId   String
  staff     StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime String    @default("09:00")
  endTime   String    @default("17:00")
  duty      String?   @default("Front desk")
  notes     String?
  status    String    @default("scheduled") // 'scheduled', 'completed', 'cancelled'
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([staffId, date])
}

model StaffLeave {
  id        String    @id @default(cuid())
  staffId   String
  staff     StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  from      DateTime
  to        DateTime
  reason    String    @default("")
  status    String    @default("pending") // 'pending', 'approved', 'rejected'
  decidedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([staffId, status])
}

model Family {
  id           String    @id // e.g. 'FAM-01'
  parentName   String
  parentPhone  String
  parentEmail  String
  pinHash      String? // Optional Argon2id hash of the family portal PIN. When set, family login requires it.
  referralCode String?  @unique
  students     Student[]
  invoices     Invoice[]
  referralsMade Referral[] @relation("Referrer")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Student {
  id                  String                @id // e.g. 'STU-001'
  name                String
  nameAr              String
  barcode             String                @unique
  photoUrl            String
  familyId        String
  family          Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  age             Int
  birthDate       DateTime?
  program             String // 'classical', 'contemporary', 'youth'
  level               String
  walletBalance       Decimal               @default(0) @db.Decimal(12, 2) // Can be negative (Debt)
  maxNegativeDebt     Decimal               @default(150.0) @db.Decimal(12, 2)
  parentName          String
  parentPhone         String
  parentEmail         String
  passwordHash        String?
  isFirstLogin        Boolean               @default(true)
  otpCode             String?
  otpExpiresAt        DateTime?
  otpAttempts         Int                   @default(0)
  otpLockedUntil      DateTime?
  failedLoginAttempts Int                   @default(0)
  loginLockedUntil    DateTime?
  subscriptions   StudentSubscription[]
  attendanceLogs  AttendanceRecord[]
  notes           StudentNote[]
  documents       StudentDocument[]
  certificates    Certificate[]
  scholarships    Scholarship[]
  waitlistEntries WaitlistEntry[]
  celebrations    CelebrationLog[]
  evaluations     SkillEvaluation[]
  orders            BoutiqueOrder[]
  invoices          Invoice[]
  payments          PaymentTransaction[]
  creditNotes       CreditNote[]
  courseEnrollments CourseEnrollment[]
  groupEnrollments  GroupEnrollment[]
  createdAt         DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

model SubscriptionPlan {
  id            String                @id // e.g. 'PLAN-PRE-PRO'
  name          String
  nameAr        String
  program       String // 'classical', 'contemporary', 'youth'
  maxSessions   Int
  durationDays  Int                   @default(30)
  price         Decimal               @default(0) @db.Decimal(12, 2)
  description   String?
  active        Boolean               @default(true)
  subscriptions StudentSubscription[]
  createdAt     DateTime              @default(now())
}

model StudentSubscription {
  id               String            @id @default(cuid())
  studentId        String
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planId           String?
  plan             SubscriptionPlan? @relation(fields: [planId], references: [id])
  planName         String
  planNameAr       String
  startDate        DateTime
  endDate          DateTime
  maxSessions      Int
  usedSessions     Int               @default(0)
  price            Decimal           @default(0) @db.Decimal(12, 2)
  dailyAccrualRate Decimal           @default(0) @db.Decimal(12, 2)
  promoCode        String?
  discountAmount   Decimal           @default(0) @db.Decimal(12, 2)
  status           String            @default("active") // 'active', 'expired_quota', 'expired_date'
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([studentId, status])
}

model AttendanceRecord {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentName     String
  barcode         String
  timestamp       DateTime @default(now())
  classTitle      String
  verifiedMethod  String   @default("hid_barcode") // 'hid_barcode', 'qr_camera', 'manual'
  premiseVerified Boolean  @default(true)
  wifiBssid       String   @default("Etoile-Secure-5G [F4:92:BF:11:80:A2]")
  status          String   @default("granted") // 'granted', 'denied_expired', 'denied_quota'
  quotaRemaining  Int

  @@index([studentId, timestamp])
}

model Product {
  id         String           @id // e.g. 'PROD-01'
  title      String
  titleAr    String
  category   String // 'pointe_shoes', 'leotards', 'tights', 'apparel', 'accessories'
  price      Decimal          @default(0) @db.Decimal(12, 2)
  sku        String           @unique
  imageUrl   String
  variants   ProductVariant[]
  orderItems OrderItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size])
}

model BoutiqueOrder {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  studentId     String?
  student       Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  customerName  String
  paymentMethod String // 'cash', 'card', 'transfer', 'wallet_debt'
  totalAmount   Decimal     @default(0) @db.Decimal(12, 2)
  ledgerStatus  String      @default("settled") // 'settled', 'charged_debt'
  items         OrderItem[]
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id        String        @id @default(cuid())
  orderId   String
  order     BoutiqueOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  title     String
  size      String
  price     Decimal       @default(0) @db.Decimal(12, 2)
  quantity  Int           @default(1)
}

model AdmissionLead {
  id                 String   @id @default(cuid())
  dancerName         String
  age                Int
  birthDate          DateTime?
  parentName         String
  parentPhone        String
  parentEmail        String
  program            String   @default("classical") // 'classical', 'contemporary', 'youth'
  division           String?  @default("pre-pro")
  experience         String?
  stage              String   @default("new_inquiry") // 'new_inquiry', 'audition_scheduled', 'evaluated', 'enrolled', 'rejected'
  notes              String?
  convertedStudentId String?
  preferredSlot      DateTime?
  source             String?  @default("web")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([stage])
}

model StudentNote {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author     String
  authorRole String
  text       String
  category   String   @default("general") // 'general', 'medical', 'tuition', 'performance'
  createdAt  DateTime @default(now())
}

model StudentDocument {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind       String   @default("other") // 'consent', 'medical', 'other'
  fileName   String
  mimeType   String
  size       Int
  data       Bytes
  uploadedBy String   @default("family")
  createdAt  DateTime @default(now())

  @@index([studentId])
}

model SkillEvaluation {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluator  String
  barre      Decimal  @default(8.5) @db.Decimal(12, 2)
  center     Decimal  @default(8) @db.Decimal(12, 2)
  allegro    Decimal  @default(8) @db.Decimal(12, 2)
  musicality Decimal  @default(9) @db.Decimal(12, 2)
  notes      String?
  date       DateTime @default(now())
}

model Certificate {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String
  titleAr   String?
  kind      String   @default("milestone") // 'attendance', 'evaluation', 'milestone', 'stage'
  meta      String?
  issuedBy  String   @default("Academy")
  createdAt DateTime @default(now())

  @@index([studentId])
}

model OpenWaLog {
  id             String   @id @default(cuid())
  recipientPhone String
  recipientName  String
  triggerEvent   String
  language       String   @default("en")
  body           String
  status         String   @default("dispatched")
  channel        String   @default("whatsapp") // 'whatsapp' | 'sms'
  createdAt      DateTime @default(now())

  @@index([channel])
}

model CrmAuditEntry {
  id        String   @id @default(cuid())
  action    String
  actor     String
  details   String
  category  String   @default("crm") // 'crm', 'auth', 'pos', 'attendance', 'financial', 'cms'
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category])
}

model PortalContentStore {
  id          String   @id @default("portal-root")
  contentJson String   @db.Text
  lastUpdated DateTime @default(now())
}

model PortalContentVersion {
  id          String   @id @default(cuid())
  label       String
  contentJson String   @db.Text
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Expense {
  id            String   @id @default(cuid())
  expenseNumber String   @unique
  category      String   // 'studio_rent', 'utilities', 'piano_maintenance', 'costumes_production', 'cleaning_sanitization', 'marketing_social', 'software_licenses', 'administrative_legal'
  description   String
  amount        Decimal  @default(0) @db.Decimal(12, 2)
  vatAmount     Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @default(0) @db.Decimal(12, 2)
  vendor        String
  paymentMethod String   // 'bank_transfer', 'petty_cash', 'corporate_card'
  status        String   @default("approved") // 'approved', 'pending_audit', 'rejected'
  receiptRef    String?
  date          DateTime @default(now())
  approvedBy    String
  requestedBy   String?
  createdAt     DateTime @default(now())

  @@index([status, date])
}

model Budget {
  id        String   @id @default(cuid())
  period    String   // 'YYYY-MM'
  category  String   // expense categories + 'payroll'
  amount    Decimal  @default(0) @db.Decimal(12, 2)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([period, category])
  @@index([period])
}

model FxRate {
  currency  String   @id // 'USD', 'EUR', ... (EGP is the base = 1, implicit)
  rateToEgp Decimal  @default(0) @db.Decimal(18, 6)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model Invoice {
  id            String               @id @default(cuid())
  invoiceNumber String               @unique
  studentId     String?
  student       Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  familyId      String?
  family        Family?              @relation(fields: [familyId], references: [id], onDelete: SetNull)
  customerName  String
  issueDate     DateTime             @default(now())
  dueDate       DateTime
  subtotal      Decimal              @default(0) @db.Decimal(12, 2)
  taxRate       Decimal              @default(0) @db.Decimal(5, 4)
  taxAmount     Decimal              @default(0) @db.Decimal(12, 2)
  total         Decimal              @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal              @default(0) @db.Decimal(12, 2)
  remainingDue  Decimal              @default(0) @db.Decimal(12, 2)
  discountAmount Decimal             @default(0) @db.Decimal(12, 2)
  discountReason String?
  status        String               @default("unpaid") // 'unpaid', 'partially_paid', 'paid', 'overdue', 'cancelled'
  agingBucket   String               @default("current") // 'current', '1_30_days', '31_60_days', 'over_60_days'
  items         InvoiceLineItem[]
  payments      PaymentTransaction[]
  creditNotes   CreditNote[]
  createdAt     DateTime             @default(now())

  @@index([status, familyId])
  @@index([dueDate])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  amount      Decimal  @default(0) @db.Decimal(12, 2)
}

model CreditNote {
  id                String   @id @default(cuid())
  creditNumber      String   @unique
  invoiceId         String
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  studentId         String?
  student           Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  familyId          String?
  amount            Decimal  @default(0) @db.Decimal(12, 2)
  reason            String   @default("")
  status            String   @default("issued") // 'issued', 'applied', 'voided'
  appliedToInvoiceId String?
  appliedAt         DateTime?
  issuedBy          String   @default("Finance")
  createdAt         DateTime @default(now())

  @@index([invoiceId, status])
}

model PaymentTransaction {
  id                String           @id @default(cuid())
  transactionNumber String           @unique
  invoiceId         String?
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  studentId         String?
  student           Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  amount            Decimal          @default(0) @db.Decimal(12, 2)
  method            String // 'cash', 'card', 'bank_transfer', 'fawry', 'instapay'
  date              DateTime         @default(now())
  receivedBy        String
  receiptNumber     String?
  notes             String?
  shiftId           String?
  shift             CashDrawerShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
}

model PayrollRecord {
  id                   String    @id @default(cuid())
  instructorId         String
  instructorName       String
  month                String // '2026-09'
  baseSalary           Decimal   @default(0) @db.Decimal(12, 2)
  hourlyRate           Decimal   @default(0) @db.Decimal(12, 2)
  hoursTaught          Decimal   @default(0) @db.Decimal(12, 2)
  privateSessionsCount Int       @default(0)
  privateSessionRate   Decimal   @default(0) @db.Decimal(12, 2)
  bonuses              Decimal   @default(0) @db.Decimal(12, 2)
  deductions           Decimal   @default(0) @db.Decimal(12, 2)
  netPayable           Decimal   @default(0) @db.Decimal(12, 2)
  status               String    @default("pending") // 'pending', 'approved', 'paid'
  preparedBy           String?
  approvedBy           String?
  paidAt               DateTime?
  paymentRef           String?
  notes                String?
  createdAt            DateTime  @default(now())
}

model JournalEntry {
  id            String             @id @default(cuid())
  voucherNumber String             @unique
  date          DateTime           @default(now())
  memo          String
  totalDebit    Decimal            @default(0) @db.Decimal(12, 2)
  totalCredit   Decimal            @default(0) @db.Decimal(12, 2)
  status        String             @default("posted") // 'draft', 'posted', 'void'
  postedBy      String
  lines         JournalEntryLine[]
  createdAt     DateTime           @default(now())
}

model JournalEntryLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountCode String
  accountName String
  debit       Decimal      @default(0) @db.Decimal(12, 2)
  credit      Decimal      @default(0) @db.Decimal(12, 2)
  notes       String?
}

model CashDrawerShift {
  id                String               @id @default(cuid())
  shiftNumber       String               @unique
  cashierName       String
  startTime         DateTime             @default(now())
  endTime           DateTime?
  openingFloat      Decimal              @default(0) @db.Decimal(12, 2)
  cashSalesTotal    Decimal              @default(0) @db.Decimal(12, 2)
  cashDrops         Decimal              @default(0) @db.Decimal(12, 2)
  expectedCash      Decimal              @default(0) @db.Decimal(12, 2)
  actualCashCounted Decimal?             @db.Decimal(12, 2)
  variance          Decimal?             @db.Decimal(12, 2)
  status            String               @default("open") // 'open', 'closed'
  notes             String?
  payments          PaymentTransaction[]
  createdAt         DateTime             @default(now())
}

model Category {
  id          String   @id @default(cuid())
  key         String   @unique // 'classical', 'contemporary', 'youth', ...
  title       String
  titleAr     String?
  description String?
  color       String?  @default("#caa868")
  icon        String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  groups      Group[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Group {
  id           String         @id @default(cuid())
  code         String         @unique // e.g. 'GRP-BAL-03'
  title        String
  titleAr      String?
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  instructorId String?
  instructor   StaffUser?     @relation("GroupLead", fields: [instructorId], references: [id], onDelete: SetNull)
  capacity     Int            @default(20)
  branchCode   String?        @default("ZAM")
  level        String?        @default("conservatory")
  active       Boolean        @default(true)
  courses      Course[]
  sessions     CourseSession[]
  enrollments  GroupEnrollment[]
  waitlist     WaitlistEntry[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([categoryId])
  @@index([instructorId])
  @@index([branchCode])
}

model GroupEnrollment {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())
  status     String   @default("active") // 'active', 'completed', 'dropped'

  @@unique([groupId, studentId])
  @@index([studentId])
}

model Course {
  id            String             @id @default(cuid())
  code          String             @unique // e.g. 'BAL-CLASS-01'
  title         String
  titleAr       String?
  description   String?
  descriptionAr String?
  groupId       String?
  group         Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  program       String // 'classical', 'contemporary', 'youth'
  level         String // 'pre-pro', 'conservatory', 'intermediate', 'beginner'
  capacity      Int                @default(20)
  instructorId  String?
  instructor    StaffUser?         @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  dayOfWeek     String?  // e.g. '["Monday", "Wednesday"]'
  startTime    String?  // e.g. '16:00'
  endTime      String?  // e.g. '17:30'
  studioRoom   String?  @default("Studio Petipa")
  branchCode   String?  @default("ZAM")
  active       Boolean  @default(true)
  enrollments   CourseEnrollment[]
  sessions      CourseSession[]
  waitlist      WaitlistEntry[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([branchCode])
}

model CourseEnrollment {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())
  status     String   @default("active") // 'active', 'completed', 'dropped'

  @@unique([courseId, studentId])
}

model CourseSession {
  id           String     @id @default(cuid())
  courseId     String?
  course       Course?    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  sessionDate  DateTime
  startTime    String
  endTime      String
  studioRoom   String     @default("Studio Petipa")
  instructorId String?
  instructor   StaffUser? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  reminderSent Boolean    @default(false)
  status       String     @default("scheduled") // 'scheduled', 'completed', 'cancelled'
  capacity     Int?
  checkinToken String?    @unique
  checkinTokenExpiresAt DateTime?
  groupId      String?
  group        Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  notes        String?
  waitlist     WaitlistEntry[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([courseId, sessionDate])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sessionId String?
  session   CourseSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // 'pending', 'promoted', 'cancelled', 'expired'
  createdAt DateTime @default(now())

  @@index([courseId, status])
  @@index([sessionId, status])
  @@index([studentId])
}

model CelebrationLog {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind      String   @default("anniversary") // 'anniversary'
  year      Int
  sentAt    DateTime @default(now())

  @@unique([studentId, kind, year])
}

model WhatsAppReminderConfig {
  id                   String   @id @default("default")
  enabled              Boolean  @default(true)
  sendMinutesBefore    Int      @default(60) // minutes before session to send notification
  studentTemplateEn    String   @default("Bonjour {studentName}! Reminder for your upcoming {courseTitle} ballet class today at {time} in {studio} with {instructorName}. Please arrive 10 mins early.")
  studentTemplateAr    String   @default("مرحباً {studentName}! نذكركم بموعد حصة {courseTitle} اليوم الساعة {time} في قاعة {studio} مع المدرب/ة {instructorName}. يرجى الحضور قبل الموعد بـ 10 دقائق.")
  instructorTemplateEn String   @default("Bonjour {instructorName}! You have a scheduled {courseTitle} session today at {time} in {studio}. Enrolled dancers: {enrolledCount}.")
  instructorTemplateAr String   @default("تحية طيبة {instructorName}! نذكركم بجدول حصتكم التدريبية {courseTitle} اليوم الساعة {time} في قاعة {studio}. عدد الطلاب المسجلين: {enrolledCount}.")
  autoCron             Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model WhatsAppGatewayConfig {
  id          String    @id @default("default")
  mode        String    @default("builtin_qr") // 'builtin_qr' | 'external_gateway'
  gatewayUrl  String?   @default("http://localhost:21465")
  apiKey      String?   @default("etoile_secret_wa_token")
  sessionName String    @default("etoile_session")
  status      String    @default("connected") // 'disconnected', 'pairing', 'connected'
  phoneNumber String?   @default("+33 6 89 20 44 11")
  pushName    String?   @default("Étoile Ballet Academy Official")
  qrCodeData  String?   @db.Text
  lastActive  DateTime? @default(now())
  updatedAt   DateTime  @updatedAt
}

model RefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique // SHA-256 hex of the opaque refresh token (raw value never stored)
  subjectType String // 'staff' | 'family' | 'student'
  subjectId   String // StaffUser.id, Family.id, or Student.id
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([subjectType, subjectId])
}

model PaymentLink {
  id          String    @id @default(cuid())
  ref         String    @unique // Unguessable provider reference, e.g. PAYMOB-A1B2C3
  provider    String // 'paymob' | 'fawry' | 'instapay'
  amount      Decimal   @default(0) @db.Decimal(12, 2)
  currency    String    @default("EGP")
  invoiceId   String?
  studentId   String?
  phone       String?
  status      String    @default("pending") // 'pending' | 'paid' | 'expired' | 'cancelled'
  url         String
  providerRef String?
  expiresAt   DateTime
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([studentId])
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. 'ZAM', 'NCAIRO'
  name      String
  nameAr    String?
  city      String   @default("Cairo")
  timezone  String   @default("Africa/Cairo")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id        String   @id @default(cuid())
  label     String   @unique // e.g. '2026-2027'
  startDate DateTime
  endDate   DateTime
  current   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  slugAr          String?   @unique
  title           String
  titleAr         String
  excerpt         String
  excerptAr       String
  content         String    @db.Text
  contentAr       String    @db.Text
  coverImageUrl   String?
  videoUrl        String?
  videoEmbedCode  String?   @db.Text
  galleryImages   String[]  @default([])
  authorName      String    @default("Étoile Editorial")
  authorNameAr    String?
  tags            String[]  @default([])
  category        String    @default("journal")
  status          String    @default("draft")
  featured        Boolean   @default(false)
  views           Int       @default(0)
  readingMinutes  Int       @default(5)
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  familyId  String?
  staffId   String?
  createdAt DateTime @default(now())

  @@index([familyId])
  @@index([staffId])
}

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  percent   Int       @default(10)
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdBy String?
  createdAt DateTime  @default(now())

  @@index([active])
}

model Scholarship {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  percent   Int      @default(25)
  reason    String   @default("")
  status    String   @default("active") // 'active', 'revoked'
  grantedBy String?
  createdAt DateTime @default(now())

  @@index([studentId, status])
}

model DiscountPolicy {
  id                 String   @id @default("default")
  sibling2Percent    Int      @default(10)
  sibling3PlusPercent Int     @default(15)
  enabled            Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model DeletionRequest {
  id          String    @id @default(cuid())
  familyId    String    @unique
  status      String    @default("pending") // 'pending', 'cancelled', 'done'
  requestedAt DateTime  @default(now())
  scheduledAt DateTime
  doneAt      DateTime?
}

model EtaDocument {
  id            String   @id @default(cuid())
  serial        String   @unique
  invoiceId     String
  uuid          String?  @unique
  status        String   @default("draft")
  payload       String   @db.Text
  qrPayload     String?  @db.Text
  submittedAt   DateTime?
  acceptedAt    DateTime?
  lastError     String?
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
}

model Referral {
  id                 String   @id @default(cuid())
  referrerFamilyId   String
  referrer           Family   @relation("Referrer", fields: [referrerFamilyId], references: [id], onDelete: Cascade)
  referredName       String   @default("")
  leadId             String?
  studentId          String?
  status             String   @default("pending") // 'pending', 'converted', 'rewarded', 'rejected'
  rewardAmount       Decimal  @default(0) @db.Decimal(12, 2)
  rewardedStudentId  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([referrerFamilyId, status])
  @@index([leadId])
}

model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  authorRole String?  @default("Parent")
  text       String   @db.Text
  textAr     String?  @db.Text
  rating     Int      @default(5)
  status     String   @default("draft") // 'draft', 'published', 'archived'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

